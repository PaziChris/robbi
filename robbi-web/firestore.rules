rules_version = '2';

// Sicherheitsregeln für Robbi.
// Kopiere diesen Text in Firebase → Firestore Database → Regeln (siehe ANLEITUNG.md).
service cloud.firestore {
  match /databases/{database}/documents {

    // Eigene Daten (Fortschritt, eigene Wörter, Push-Einstellung): nur du selbst.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /prog/{lang} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Rangliste: alle Angemeldeten dürfen lesen, jeder schreibt nur seinen eigenen Eintrag.
    match /scores/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 24
        && request.resource.data.xp is number && request.resource.data.xp >= 0;
    }

    // Duelle: nur die beiden Spieler sehen sie. Wer herausfordert, legt an;
    // der Herausgeforderte trägt sein Ergebnis ein.
    match /duels/{id} {
      allow read: if request.auth != null
        && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.a == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if request.auth != null
        && resource.data.b == request.auth.uid
        && resource.data.status == 'open'
        && request.resource.data.a == resource.data.a
        && request.resource.data.b == resource.data.b
        && request.resource.data.aScore == resource.data.aScore;
    }
  }
}
